    "contract": {
      "criterion": "CC-11 Reviewed live day prerequisite correctness only: preserve the scalar affordance-schema and exact-day action-boundary repairs without claiming that CC-4 or CC-11 is satisfied.",
      "evidence_claim": "Focused adapter and world regressions plus a provider-free consequential-choice day demonstrate only that the preserved repairs remove the observed schema ambiguity and minute-1410 terminal failure; they do not supply or imply a conflict-informed live-model decision.",
      "gates": [
        {
          "check": "python3 -m unittest tests.test_ollama_client.OllamaDecisionClientTests.test_request_formats_use_only_current_scalar_affordance_options tests.test_ollama_client.OllamaDecisionClientTests.test_affordance_schema_preparation_does_not_mutate_caller_state",
          "expect": "Current per-request string options appear as detached response-schema enums, numeric options remain unconstrained, and caller-owned schema state remains unchanged across calls."
        },
        {
          "check": "python3 -m unittest tests.test_autonomous_day_world.AutonomousDayWorldTests.test_late_reachable_travel_is_rejected_without_crossing_day_boundary",
          "expect": "The seed-44 consequential-choice composition reaches tick 1440 with no runtime failure or pending action, and the minute-1410 travel attempt is causally rejected with matching actor-safe result and private decision resolution."
        },
        {
          "check": "python3 -m scenarios.autonomous_day --seed 44 --focal-policy scripted --consequential-choice",
          "expect": "The provider-free consequential-choice command completes at Day 1 00:00 without a runtime failure while remaining explicitly scripted rather than live evidence."
        },
        {
          "check": "git diff --check",
          "expect": "The complete bounded slice has no whitespace errors."
        }
      ],
      "intended_result": "Each Ollama request constrains eligible scalar string parameters to the options in that request's actor-visible affordances without mutating shared schema state, and any otherwise accepted duration-bearing Mara action that would finish after Day 1 00:00 is actor-safely rejected before pending work is created so the composed day reaches the exact boundary.",
      "scope": [
        "policies/ollama_client.py",
        "scenarios/autonomous_day.py",
        "tests/test_ollama_client.py",
        "tests/test_autonomous_day_world.py",
        "docs/plans/AUTONOMOUS_LOOP_STATE.json",
        "docs/plans/CURRENT.md",
        "docs/plans/first-consequential-choice/IMPLEMENTATION_PLAN.md"
      ],
      "validation": [
        "python3 -m unittest tests.test_ollama_client tests.test_autonomous_day_world",
        "./scripts/check.sh"
      ]
    },
